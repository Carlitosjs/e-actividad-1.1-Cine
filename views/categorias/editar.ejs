<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar Categoría - CineApp</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
  <h1>Editar Categoría</h1>
  <form action="/categorias/<%= categoria._id %>/editar" method="POST" class="mt-3">
    <div class="mb-3">
      <label class="form-label">Nombre</label>
      <input type="text" name="nombre" value="<%= categoria.nombre %>" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Descripción</label>
      <input type="text" name="descripcion" value="<%= categoria.descripcion || '' %>" class="form-control">
    </div>
    <button type="submit" class="btn btn-primary">Actualizar</button>
    <a href="/categorias" class="btn btn-secondary">Cancelar</a>
  </form>
</body>
</html>