<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <%- include('../partials/navbar') %>

  <div class="container my-5">
    <div class="row justify-content-center">
      <div class="col-md-6">
        <div class="card shadow-sm">
          <div class="card-header bg-primary text-white fw-bold">
            <h4 class="card-title mb-0"><%= titulo %></h4>
          </div>
          <div class="card-body">
            <form action="/funciones/nueva" method="POST">
              
              <!-- Selección de Película -->
              <div class="mb-3">
                <label for="peliculaId" class="form-label fw-bold">Película:</label>
                <select id="peliculaId" name="peliculaId" class="form-select" required>
                  <option value="" disabled selected>-- Selecciona una Película --</option>
                  <% peliculas.forEach(pelicula => { %>
                    <option value="<%= pelicula.id %>"><%= pelicula.titulo %></option>
                  <% }) %>
                </select>
              </div>

              <!-- Selección de Sala -->
              <div class="mb-3">
                <label for="salaId" class="form-label fw-bold">Sala:</label>
                <select id="salaId" name="salaId" class="form-select" required>
                  <option value="" disabled selected>-- Selecciona una Sala --</option>
                  <% salas.forEach(sala => { %>
                    <option value="<%= sala.id %>"><%= sala.nombre %> (<%= sala.tipo %>)</option>
                  <% }) %>
                </select>
              </div>

              <!-- Fecha y Hora -->
              <div class="mb-3">
                <label for="fechaHora" class="form-label fw-bold">Fecha y Hora:</label>
                <input type="datetime-local" id="fechaHora" name="fechaHora" class="form-control" required>
              </div>

              <div class="d-flex justify-content-between mt-4">
                <a href="/funciones" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary fw-bold">Guardar Función</button>
              </div>

            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>

</body>
</html>