<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <%- include('../partials/navbar') %>

  <div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="fw-bold"><%= titulo %></h1>
      <a href="/funciones/nueva" class="btn btn-primary fw-bold">+ Nueva Función</a>
    </div>

    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th>ID</th>
          <th>Película</th>
          <th>Sala</th>
          <th>Fecha / Hora</th>
          <th class="text-center">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (funciones && funciones.length > 0) { %>
          <% funciones.forEach(funcion => { %>
            <tr>
              <td><%= funcion.id %></td>
              <td class="fw-bold"><%= funcion.peliculaNombre %></td>
              <td><span class="badge bg-secondary"><%= funcion.salaNombre %></span></td>
              <td><%= (funcion.fechaHora || '').replace('T', ' - ') %></td>
              <td class="text-center">
                <form action="/funciones/<%= funcion.id %>/eliminar" method="POST" class="d-inline" onsubmit="return confirm('¿Deseas eliminar esta función?')">
                  <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" class="text-center text-muted">No hay funciones registradas.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <%- include('../partials/footer') %>

</body>
</html>