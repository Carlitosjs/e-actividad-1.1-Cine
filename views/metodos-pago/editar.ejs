<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar Método de Pago - CineApp</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../partials/navbar') %>

  <main class="container my-5 flex-grow-1">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        <h1 class="fw-bold mb-4">Editar Método de Pago</h1>
        <form action="/metodos-pago/<%= metodo._id %>/editar" method="POST">
          <div class="mb-3">
            <label class="form-label">Tipo</label>
            <input type="text" name="tipo" value="<%= metodo.tipo %>" class="form-control" required>
          </div>
          <div class="form-check mb-4">
            <input type="checkbox" name="activo" class="form-check-input" id="activoCheck" <%= metodo.activo ? 'checked' : '' %>>
            <label class="form-check-label" for="activoCheck">Activo</label>
          </div>
          <button type="submit" class="btn btn-primary">Actualizar</button>
          <a href="/metodos-pago" class="btn btn-secondary ms-2">Cancelar</a>
        </form>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>