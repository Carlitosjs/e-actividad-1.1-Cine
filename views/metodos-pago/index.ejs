<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof titulo !== 'undefined' ? titulo : 'Métodos de Pago' %> - CineApp</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../partials/navbar') %>

  <main class="container my-5 flex-grow-1">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="fw-bold mb-0">Métodos de Pago</h1>
      <a href="/metodos-pago/nueva" class="btn btn-primary">+ Nuevo Método de Pago</a>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-dark">
          <tr>
            <th>Tipo</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (metodos && metodos.length > 0) { %>
            <% metodos.forEach(metodo => { %>
              <tr>
                <td class="fw-semibold"><%= metodo.tipo %></td>
                <td>
                  <% if (metodo.activo) { %>
                    <span class="badge bg-success">Activo</span>
                  <% } else { %>
                    <span class="badge bg-secondary">Inactivo</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <a href="/metodos-pago/<%= metodo._id %>/editar" class="btn btn-warning btn-sm me-1">Editar</a>
                  <form action="/metodos-pago/<%= metodo._id %>/eliminar" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Eliminar este método de pago?')">Eliminar</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="3" class="text-center text-muted py-4">No hay métodos de pago registrados.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>