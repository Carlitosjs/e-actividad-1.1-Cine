<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reservaciones - CineApp</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; padding: 0; background-color: #f4f4f9; }
    .container { padding: 0 30px; }
    table { width: 100%; border-collapse: collapse; margin-top: 20px; background: #fff; }
    th, td { border: 1px solid #ddd; padding: 12px; text-align: left; }
    th { background-color: #007bff; color: white; }
    tr:nth-child(even) { background-color: #f2f2f2; }
    .status { background: #17a2b8; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.9em; }
  </style>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container">
    <h1>Listado de Reservaciones</h1>
    
    <table>
      <thead>
        <tr>
          <th>ID Reservación</th>
          <th>ID Ticket</th>
          <th>Usuario / Cliente</th>
          <th>Estado</th>
        </tr>
      </thead>
      <tbody>
        <% reservaciones.forEach(reser => { %>
          <tr>
            <td><%= reser.id %></td>
            <td>Ticket #<%= reser.ticketId %></td>
            <td><strong><%= reser.usuario %></strong></td>
            <td><span class="status"><%= reser.estado %></span></td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <%- include('partials/footer') %>
  </div>
</body>
</html>