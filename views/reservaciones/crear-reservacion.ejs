<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nueva Reservación - CineApp</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <%- include('../partials/navbar') %>

  <div class="container my-5" style="max-width: 600px;">
    <h1 class="fw-bold mb-4">Nueva Reservación</h1>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/reservaciones/nueva" method="POST" class="card p-4 shadow-sm bg-white">
      <!-- Selector de Función de Cine -->
      <div class="mb-3">
        <label for="funcionId" class="form-label fw-semibold">Seleccionar Función / Película:</label>
        <select name="funcionId" id="funcionId" class="form-select" required>
          <option value="">-- Selecciona una Función --</option>
          <% if (typeof funciones !== 'undefined' && funciones.length > 0) { %>
            <% funciones.forEach(f => { %>
              <option value="<%= f.id %>">
                <%= f.tituloPelicula %> - Horario: <%= f.horario || 'Por definir' %>
              </option>
            <% }) %>
          <% } else { %>
            <option value="1">Función #1 - Película Principal</option>
          <% } %>
        </select>
      </div>

      <!-- Nombre del Cliente -->
      <div class="mb-3">
        <label for="usuario" class="form-label fw-semibold">Nombre del Cliente:</label>
        <input type="text" name="usuario" id="usuario" class="form-control" placeholder="Ej. Carlos Valles" required>
      </div>

      <!-- Estado de la Reservación -->
      <div class="mb-4">
        <label for="estado" class="form-label fw-semibold">Estado de Reservación:</label>
        <select name="estado" id="estado" class="form-select">
          <option value="Pendiente" selected>Pendiente</option>
          <option value="Confirmada">Confirmada</option>
        </select>
      </div>

      <div class="d-flex justify-content-between">
        <a href="/reservaciones" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary fw-bold">Guardar Reservación</button>
      </div>
    </form>
  </div>

  <%- include('../partials/footer') %>

</body>
</html>