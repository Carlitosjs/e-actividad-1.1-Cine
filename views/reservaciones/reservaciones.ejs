<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reservaciones - CineApp</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <%- include('../partials/navbar') %>

  <div class="container my-5">
    <!-- Encabezado con Botón -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="fw-bold"><%= typeof titulo !== 'undefined' ? titulo : 'Listado de Reservaciones' %></h1>
      <a href="/reservaciones/nueva" class="btn btn-primary fw-bold">+ Nueva Reservación</a>
    </div>

    <!-- Tabla de Reservaciones -->
    <table class="table table-striped table-hover align-middle shadow-sm">
      <thead class="table-dark">
        <tr>
          <th>ID Reservación</th>
          <th>ID Ticket</th>
          <th>Usuario / Cliente</th>
          <th>Estado</th>
        </tr>
      </thead>
      <tbody>
        <% if (reservaciones && reservaciones.length > 0) { %>
          <% reservaciones.forEach(reser => { %>
            <tr>
              <td><%= reser.id %></td>
              <td>Ticket #<%= reser.ticketId %></td>
              <td class="fw-bold"><%= reser.usuario || reser.cliente %></td>
              <td>
                <span class="badge <%= reser.estado === 'Confirmada' ? 'bg-success' : 'bg-warning text-dark' %>">
                  <%= reser.estado %>
                </span>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="4" class="text-center text-muted">No hay reservaciones registradas.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <%- include('../partials/footer') %>

</body>
</html>