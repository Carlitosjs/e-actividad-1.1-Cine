<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <%- include('../partials/navbar') %>

  <div class="container my-5">
    <div class="row justify-content-center">
      <div class="col-md-6">
        <div class="card shadow-sm">
          <div class="card-header bg-warning text-dark fw-bold">
            <h4 class="card-title mb-0"><%= titulo %></h4>
          </div>
          <div class="card-body">
            <form action="/salas/<%= sala.id %>/editar" method="POST">
              
              <div class="mb-3">
                <label for="nombre" class="form-label fw-bold">Nombre de la Sala:</label>
                <input type="text" id="nombre" name="nombre" class="form-control" value="<%= sala.nombre %>" required>
              </div>

              <div class="mb-3">
                <label for="capacidad" class="form-label fw-bold">Capacidad (Asientos):</label>
                <input type="number" id="capacidad" name="capacidad" class="form-control" value="<%= sala.capacidad %>" min="1" required>
              </div>

              <div class="mb-3">
                <label for="tipo" class="form-label fw-bold">Tipo / Formato:</label>
                <select id="tipo" name="tipo" class="form-select" required>
                  <option value="2D" <%= sala.tipo === '2D' ? 'selected' : '' %>>2D</option>
                  <option value="3D" <%= sala.tipo === '3D' ? 'selected' : '' %>>3D</option>
                  <option value="IMAX" <%= sala.tipo === 'IMAX' ? 'selected' : '' %>>IMAX</option>
                  <option value="4DX" <%= sala.tipo === '4DX' ? 'selected' : '' %>>4DX</option>
                </select>
              </div>

              <div class="d-flex justify-content-between mt-4">
                <a href="/salas" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary fw-bold">Actualizar Sala</button>
              </div>

            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>

</body>
</html>