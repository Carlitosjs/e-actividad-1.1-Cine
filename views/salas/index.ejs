<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <%- include('../partials/navbar') %>

  <div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="fw-bold"><%= titulo %></h1>
      <a href="/salas/nueva" class="btn btn-primary fw-bold">+ Nueva Sala</a>
    </div>

    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th>ID</th>
          <th>Nombre</th>
          <th>Capacidad</th>
          <th>Tipo / Formato</th>
          <th class="text-center">Acciones</th>
        </tr>
      </thead>
      
      <tbody>
        <% if (salas && salas.length > 0) { %>
          <% salas.forEach((sala, index) => { %>
            <tr>
                    
                    <td><%= index + 1 %></td> 
                    <td><%= sala.nombre %></td>
                    <td><%= sala.capacidad %> asientos</td>
                    <td>
                      <span class="badge bg-info"><%= sala.tipo %></span>
                    </td>
                    <td>
                      <a href="/salas/<%= sala._id %>/editar" class="btn btn-warning btn-sm">Editar</a>
                      <form action="/salas/<%= sala._id %>/eliminar" method="POST" style="display:inline;">
                        <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                      </form>
                    </td>
                  </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" class="text-center text-muted">No hay salas registradas.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <%- include('../partials/footer') %>

</body>
</html>