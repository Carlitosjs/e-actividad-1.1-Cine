<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <%- include('../partials/navbar') %>

  <div class="container my-5">
    <div class="row justify-content-center">
      <div class="col-md-6">
        <div class="card shadow-sm">
          <div class="card-header bg-primary text-white fw-bold">
            <h4 class="card-title mb-0"><%= titulo %></h4>
          </div>
          <div class="card-body">
            <form action="/tickets/nuevo" method="POST">
              
              <!-- Selección de Función -->
              <div class="mb-3">
                <label for="funcionId" class="form-label fw-bold">Función:</label>
                <select id="funcionId" name="funcionId" class="form-select" required>
                  <option value="" disabled selected>-- Selecciona una Función --</option>
                  <% funciones.forEach(funcion => { %>
                    <option value="<%= funcion.id %>">
                      <%= funcion.peliculaNombre %> - <%= funcion.fechaHora ? funcion.fechaHora.replace('T', ' ') : 'Sin fecha' %>
                    </option>
                  <% }) %>
                </select>
              </div>

              <!-- Nombre del Cliente -->
              <div class="mb-3">
                <label for="cliente" class="form-label fw-bold">Nombre del Cliente:</label>
                <input type="text" id="cliente" name="cliente" class="form-control" placeholder="Ej. Carlos Valles" required>
              </div>

              <!-- Asiento -->
              <div class="mb-3">
                <label for="asiento" class="form-label fw-bold">Asiento:</label>
                <input type="text" id="asiento" name="asiento" class="form-control" placeholder="Ej. A-12, B-05" required>
              </div>

              <!-- Precio -->
              <div class="mb-3">
                <label for="precio" class="form-label fw-bold">Precio ($):</label>
                <input type="number" step="0.01" id="precio" name="precio" class="form-control" placeholder="Ej. 8.50" required>
              </div>

              <div class="d-flex justify-content-between mt-4">
                <a href="/tickets" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary fw-bold">Emitir Ticket</button>
              </div>

            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>

</body>
</html>