<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <%- include('../partials/navbar') %>

  <div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="fw-bold"><%= titulo %></h1>
      <a href="/tickets/nuevo" class="btn btn-primary fw-bold">+ Emitir Ticket</a>
    </div>

    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th>ID</th>
          <th>Cliente</th>
          <th>Película / Sala</th>
          <th>Asiento</th>
          <th>Precio</th>
          <th class="text-center">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (tickets && tickets.length > 0) { %>
          <% tickets.forEach((t , index) => { %>
        <tr>
            <td><%= index+1%></td>
            <td class="fw-bold"><%= t.cliente %></td>
            <td>
              <% if (t.funcionId && t.funcionId.peliculaId && t.funcionId.salaId) { %>
                <%= t.funcionId.peliculaId.titulo %> (<%= t.funcionId.salaId.nombre %>)
              <% } else { %>
                Información no disponible
              <% } %>
            </td>
            <td><span class="badge bg-info text-dark"><%= t.asiento %></span></td>
            <td><%= t.precio ? t.precio.toFixed(2) : '0.00' %></td>
            <td class="text-center">
              <form action="/tickets/<%= t._id %>/eliminar" method="POST" class="d-inline" onsubmit="return confirm('¿Deseas cancelar este ticket?')">
                <button type="submit" class="btn btn-danger btn-sm">Cancelar</button>
              </form>
            </td>
        </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" class="text-center text-muted">No hay tickets emitidos.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <%- include('../partials/footer') %>

</body>
</html>